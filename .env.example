# ── Chat 对话（DeepSeek）──
OPENAI_API_KEY=your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=deepseek-v4-flash

# ── Embedding 向量嵌入（需单独配置，DeepSeek 不支持 /v1/embeddings）──
# 方案 A：OpenAI
OPENAI_EMBEDDING_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSION=1536

# 方案 B：阿里云百炼 Qwen（Chat + Embedding 同一 Key）
# OPENAI_API_KEY=your-dashscope-api-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# OPENAI_CHAT_MODEL=qwen-plus
# 推理模型 qwen3.7-plus 响应慢，需 AiHttpClientConfig 读超时 3min（见 INC-013）；快速联调用 qwen-plus
# OPENAI_EMBEDDING_API_KEY=your-dashscope-api-key
# OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# 或显式带 /v1（与 embeddings-path=/embeddings 配套，见 INC-010）：
# OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-v4
# RAG_EMBEDDING_DIMENSION=1536
# 注意：application.yml 已配置 embeddings-path=/embeddings（Spring AI 会自动补 /v1 前缀）

# 方案 C：硅基流动（取消注释并替换方案 A，维度需改为 1024 并重建 Milvus Collection）
# OPENAI_EMBEDDING_API_KEY=your-siliconflow-api-key
# OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# RAG_EMBEDDING_DIMENSION=1024

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default

# RAG
RAG_COLLECTION_NAME=enterprise_knowledge
# DashScope text-embedding-v4 单次最多 10 条；OpenAI 可设更大
# RAG_EMBEDDING_BATCH_SIZE=10
# Spring AI 会话记忆窗口大小（消息条数），超出后丢弃最旧消息
# RAG_CHAT_MEMORY_MAX_MESSAGES=20
